{
  "_comment": "Production configuration example using MongoDB and Kafka",
  
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Orleans": "Information"
    }
  },
  
  "ConnectionStrings": {
    "MongoDB": "mongodb://mongodb-cluster:27017/AevatarBusiness?replicaSet=rs0"
  },
  
  "Orleans": {
    "ClusterId": "aevatar-production",
    "ServiceId": "aevatar-service",
    "SiloPort": 11111,
    "GatewayPort": 30000
  },
  
  "Storage": {
    "Provider": "MongoDB",
    "DatabaseName": "AevatarBusiness"
  },
  
  "Streaming": {
    "Provider": "Kafka",
    "ProviderName": "KafkaStreamProvider",
    "DefaultNamespace": "agent-events",
    "GetQueueMsgsTimerPeriodMs": 50
  },
  
  "Kafka": {
    "BootstrapServers": "kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092",
    "ConsumerGroupId": "aevatar-production-consumers",
    "PollTimeoutMs": 100,
    "GetQueueMsgsTimerPeriodMs": 50,
    "DefaultPartitions": 16,
    "DefaultReplicationFactor": 3,
    "Topics": {
      "AgentEvents": {
        "Name": "agent-events",
        "Partitions": 16,
        "ReplicationFactor": 3,
        "AutoCreate": true
      },
      "SystemEvents": {
        "Name": "system-events",
        "Partitions": 8,
        "ReplicationFactor": 3,
        "AutoCreate": true
      }
    }
  },
  
  "EventSourcing": {
    "Enabled": true,
    "SnapshotFrequency": 50,
    "Provider": "MongoDB"
  },
  
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Orleans": "Information"
      }
    }
  }
}

